# Public base URL of the site (no trailing slash). Card chips use <SITE_URL>/c/<CODE>.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Written by `neon deploy` / `neon env pull` (do not edit by hand) ---
# Postgres: pooled URL for the app, direct URL for migrations
DATABASE_URL=
DATABASE_URL_UNPOOLED=
NEON_BRANCH=
# Neon Auth (Managed Better Auth)
NEON_AUTH_BASE_URL=
NEON_AUTH_JWKS_URL=
# Neon Object Storage (S3-compatible, bucket "avatars")
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL_S3=
AWS_REGION=

# --- App secrets (not managed by Neon) ---
# 32+ random chars for signing session cookies: openssl rand -base64 32
NEON_AUTH_COOKIE_SECRET=
