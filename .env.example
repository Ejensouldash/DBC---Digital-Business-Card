# Public base URL of the site (no trailing slash). Card chips use <SITE_URL>/c/<CODE>.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Written by `neon deploy` / `neon env pull` (do not edit by hand) ---
# Postgres: pooled URL for the app, direct URL for migrations
DATABASE_URL=
DATABASE_URL_UNPOOLED=
NEON_BRANCH=
# Neon Auth (Managed Better Auth)
NEON_AUTH_BASE_URL=
NEON_AUTH_JWKS_URL=

# --- Cloudflare R2 (profile images) ---
# Account ID from the R2 overview page; an R2 API token with Object Read & Write on the bucket.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Public bucket URL: https://pub-<hash>.r2.dev (development) or your custom domain
R2_PUBLIC_URL=

# --- App secrets (not managed by Neon) ---
# 32+ random chars for signing session cookies: openssl rand -base64 32
NEON_AUTH_COOKIE_SECRET=

# Shown on /privacy for PDPA requests. Required in production.
CONTACT_EMAIL=

# Neon API, used only by Settings > Delete account (Neon Auth has no self-delete).
# Create a project-scoped key: neon api-keys create --name dbc-account-deletion --project-id <id>
NEON_API_KEY=
NEON_PROJECT_ID=
NEON_BRANCH_ID=
