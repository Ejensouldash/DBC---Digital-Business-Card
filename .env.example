# Public base URL of the site (no trailing slash). Card chips use <SITE_URL>/c/<CODE>.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase project (Dashboard → Project Settings → API Keys)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Publishable key (sb_publishable_...) or legacy anon key
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Secret key (sb_secret_...) or legacy service_role key. Server only, never expose.
SUPABASE_SERVICE_ROLE_KEY=
